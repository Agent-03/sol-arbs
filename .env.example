SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
# Optional secondary HTTP JSON-RPC, e.g. Alchemy or QuickNode.
# Use a newly generated API key. Do not commit real endpoints/credentials.
# Example: https://solana-mainnet.g.alchemy.com/v2/YOUR_REPLACEMENT_ALCHEMY_KEY
SOLANA_BACKUP_RPC_URL=
# WebSocket subscriptions continue using SOLANA_WS_URL (Helius).

# Optional manual override; auto-discovery is enabled when this is blank
POOL_ADDRESSES=
MAX_DISCOVERED_POOLS=20
POLL_INTERVAL_MS=60000
STALE_AFTER_MS=120000
HEALTH_PORT=8787
DATA_DIR=./data
# Reduce read-only quote cycles to avoid free/limited RPC 429 rate limits.
AMM_V4_SCAN_INTERVAL_MS=60000
# Indicative-only tolerance: HTTP pacing can span several Solana slots.
AMM_V4_MAX_SLOT_SKEW=12
ORCA_SCAN_INTERVAL_MS=60000
# B5: on-chain Raydium state streams; only listed USD notionals are evaluated
B5_QUOTE_SIZES_USD=5,10,25
# HTTP reconciles fill WS gaps; no HTTP request on a Raydium WS update.
B5_RAYDIUM_RECONCILE_MS=12000
B5_MAX_COMPONENT_AGE_MS=20000
# Orca SDK still needs RPC-backed tick arrays; quotes stream per completed leg.
B5_ORCA_REFRESH_MS=15000
B5_ORCA_EVENT_COOLDOWN_MS=12000
# Phase C2: local Whirlpool + CLMM tick-array SDK pricing from the shared
# C1 account cache. First bootstrap may still need RPC; quote hot path is local
# only while all required pool/tick/config accounts pass age and slot checks.
# Set 0 to restore the B5.2 SDK polling path if live C2 behaves unexpectedly.
C2_LOCAL_QUOTES_ENABLED=1
# Read-only one-pool baseline comparison: POST /api/actions/validate (60s cooldown).
# B5.2: fast SDK polling quotes Orca USDC->SOL; C3B now also checks
# the reverse using network-free C2 local exact-input math when ready.
# Prior comment: FAST only quotes Orca USDC->SOL, then computes its
# Raydium AMM V4 / CLMM sell leg locally. Reverse direction is not monitored.
# Change to 'full' to restore exact-input Orca reverse SDK quotes (slower).
B5_2_ORCA_QUOTE_MODE=fast
# Phase B5.1: cap RPC-heavy CLMM SDK tick-array refreshes.
# Quotes remain indicative: pool and tick-array RPC slots are not coherent.
B5_1_CLMM_MAX_POOLS=3
B5_1_CLMM_REFRESH_MS=45000
B5_1_CLMM_MAX_CACHE_AGE_MS=60000
# Phase B4: only compare research quotes inside these observation limits.
# These values do NOT prove same-slot execution or trade profitability.
B4_MAX_QUOTE_AGE_MS=15000
B4_MAX_QUOTE_GAP_MS=4000
B4_MAX_SLOT_SKEW=12
B4_MIN_POOL_LIQUIDITY_USD=10000
# Refresh SOL/USDC pool candidates periodically; no-profit refresh is faster but capped.
DISCOVERY_REFRESH_MS=900000
NO_PROFIT_DISCOVERY_MS=300000
# C1: unified dependency-aware WebSocket account feed shares the configured
# SOLANA_WS_URL across pool discovery and Raydium AMM vault observers.
# Uses B4_MAX_QUOTE_AGE_MS / B4_MAX_SLOT_SKEW to assess feed health.
# No Yellowstone/Geyser stream is connected until a provider is configured.
# Orca/CLMM tick-array SDK reads remain RPC-backed until C2.
# Account events are still journaled to JSONL; console logging is optional.
LOG_ACCOUNT_UPDATES=0
# Shared Solana RPC HTTP limiter. All pool/Orca/SDK requests are serialized.
RPC_HTTP_MIN_SPACING_MS=1000
RPC_HTTP_MAX_RETRIES=2
RPC_HTTP_429_BACKOFF_MS=5000
RPC_HTTP_429_MAX_BACKOFF_MS=60000

# C3A: read-only, ON-DEMAND on-chain evidence sampling.
# Uses a separate HTTP lane, prioritizing the backup RPC if configured.
# Optional third endpoint for historical sampling; keep actual API keys ONLY in .env.
C3_HISTORY_RPC_URL=
# One run samples at most 4 supported pools and analyzes 12 unique transactions.
# Deliberately conservative: never run a full-chain crawler inside live quotes.
C3_SAMPLE_POOL_COUNT=4
C3_SIGNATURES_PER_POOL=8
C3_MAX_TRANSACTIONS_PER_SCAN=12
C3_SCAN_COOLDOWN_MS=300000
C3_HISTORY_RPC_MIN_SPACING_MS=1500
# GET /api/c3 gives classifications and limitations.
# POST /api/actions/c3-analyze launches a historical sample (localhost only).
# Journal: DATA_DIR/c3-onchain-evidence.jsonl, ignored by git.
# No signed transactions, wallet keys, or guaranteed profit attribution.

# C3B: local two-/three-leg multi-token route graph (read-only).
# Supports Raydium AMM V4 pool-state accounts for SOL, USDC, USDT, JUP.
# Discovery queries 6 pairs at startup then every 10 minutes. Once subscribed,
# route enumeration is local on account-change events: no per-route HTTP calls.
# The existing C2 Orca/CLMM SOL/USDC monitor also now prices both directions
# from ready local state in fast mode, without an extra SDK/RPC reverse refresh.
C3_GRAPH_ENABLED=1
C3_GRAPH_MAX_POOLS=18
C3_GRAPH_PER_PAIR=3
C3_GRAPH_REFRESH_MS=600000
C3_GRAPH_RECONCILE_MS=15000
C3_GRAPH_MAX_PATH_CHECKS=10000
C3_GRAPH_MAX_RESULTS=50
C3_GRAPH_MIN_LIQUIDITY_USD=50000
C3_GRAPH_SIZES_USD=500,2500,5000
# GET /api/c3/graph: tracked pools, eligible quote state, evaluated cycles,
# twoLegCycles, threeLegCycles, positiveIndicative and pool/route warnings.
# No signed transactions, slippage guarantee, same-slot execution or live P&L.

# Jupiter Swap V2 quote-only monitor; leave key blank for keyless testing (0.5 requests/sec limit)
JUPITER_API_KEY=
JUPITER_SIZES_USD=5,10,25,50,80
JUPITER_SCAN_INTERVAL_MS=60000
JUPITER_REQUEST_SPACING_MS=2200
# Assumed combined costs in USDC; NOT measured swap gas/priority fees or firm execution cost
JUPITER_ASSUMED_COST_USD=0.02
